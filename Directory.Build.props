<Project>
  <PropertyGroup>
    <HalfGripAssembliesDump Condition="'$(HalfGripAssembliesDump)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\half grip\Assemblies'))</HalfGripAssembliesDump>
    <HalfGripManaged Condition="'$(HalfGripManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Half Grip Demo\HalfGrip_Data\Managed</HalfGripManaged>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)third_party\BepInExPack\BepInEx\core</BepInExCore>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
